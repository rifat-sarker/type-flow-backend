PORT=4000
MONGO_URI=mongodb://localhost:27017/typeflow
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
CLIENT_ORIGIN=http://localhost:3000
NODE_ENV=development

# Optional: sends OTP emails (register verification + password reset) via SMTP.
# If left unset, OTP codes are just logged to the console instead - fine for local dev.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Optional: seeds one admin account on server startup (idempotent - skipped if an
# admin already exists). Promotes an existing user with this email, or creates one.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public URL of THIS backend - OAuth callback URLs are built from it
SERVER_URL=http://localhost:4000

# Optional: social login. Leave blank to hide the buttons entirely.
# Google  -> console.cloud.google.com > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub  -> github.com/settings/developers > New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
